{
  "name": "ristolandia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -b",
    "format": "prettier --write src server tests scripts docs shared *.ts *.json *.md index.html .github/workflows/ci.yml",
    "format:check": "prettier --check src server tests scripts docs shared *.ts *.json *.md index.html .github/workflows/ci.yml",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm test && npm run build",
    "backup": "node scripts/backup.mjs save",
    "restore": "node scripts/backup.mjs restore"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.56.0",
    "@axe-core/playwright": "^4.10.0"
  },
  "engines": {
    "node": ">=24"
  }
}
